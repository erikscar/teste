<Window x:Class="Macro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Macro MIR4" Width="1280" Height="800" MinWidth="1000" MinHeight="650" Background="{StaticResource CanvasBrush}" FontFamily="{StaticResource PoppinsFont}">
    <Window.Resources>
        <Style x:Key="NavigationItem" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#C9C9C3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" Padding="13,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="18" Height="18" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.FontSize="13" TextElement.FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C2D29"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D8B77D"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#171B17" BorderBrush="#3A3D34" BorderThickness="0,0,1,0" Padding="14,22,14,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="8,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#30291F" BorderBrush="#6A5535" BorderThickness="0,0,0,2" Width="36" Height="36" CornerRadius="5" Margin="0,0,11,0">
                            <Path Data="M2,17 L2,3 L10,12 L18,3 L18,17" Width="19" Height="16" Stretch="Uniform" Stroke="#E3C38F" StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MIR4" FontSize="19" FontWeight="Bold" Foreground="#F5F0E5"/>
                            <TextBlock Text="CENTRAL DE ROTINAS" FontSize="8" Foreground="#8C9287" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="NAVEGAÇÃO" FontSize="9" FontWeight="SemiBold" Foreground="#7F877C" Margin="13,0,0,9"/>
                    <Button x:Name="BtnHome" Style="{StaticResource NavigationItem}" Content="Início" Click="BtnHome_Click" Tag="M2,10 L12,2 L22,10 M5,8 L5,22 L10,22 L10,15 L14,15 L14,22 L19,22 L19,8"/>
                    <Button x:Name="BtnPresets" Style="{StaticResource NavigationItem}" Content="Presets" Click="BtnPresets_Click" Tag="M3,3 L21,3 L21,8 L3,8 Z M3,12 L21,12 L21,21 L3,21 Z M7,16 L17,16"/>
                    <Button x:Name="BtnFarming" Style="{StaticResource NavigationItem}" Content="Farming" Click="BtnFarming_Click" Tag="M3,21 L16,8 M7,3 L13,3 L21,11 L21,17 L17,13 L11,7 Z"/>
                    <Border Height="1" Background="#30322E" Margin="12,12"/>
                    <TextBlock Text="FERRAMENTAS" FontSize="9" FontWeight="SemiBold" Foreground="#7F877C" Margin="13,0,0,9"/>
                    <Button x:Name="BtnTimer" Style="{StaticResource NavigationItem}" Content="Timer" Click="BtnTimer_Click" Tag="M12,2 A10,10 0 1 1 11.99,2 M12,6 L12,12 L17,15"/>
                    <Button x:Name="BtnDaily" Style="{StaticResource NavigationItem}" Content="Mapas" Click="BtnDaily_Click" Tag="M2,5 L8,2 L16,5 L22,2 L22,19 L16,22 L8,19 L2,22 Z M8,2 L8,19 M16,5 L16,22"/>
                    <Button x:Name="BtnCapture" Style="{StaticResource NavigationItem}" Content="Teste de captura" Click="BtnCapture_Click" Tag="M3,3 L21,3 L21,21 L3,21 Z M3,9 L21,9 M9,21 L9,9 M14,14 L16,16 L19,12"/>
                </StackPanel>
                <Border Grid.Row="2" Background="#1C201A" BorderBrush="#65563C" BorderThickness="0,1,0,0" CornerRadius="5" Padding="13" Margin="0,22,0,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="ATIVIDADE DO MACRO" FontSize="9" FontWeight="SemiBold" Foreground="#949D8D"/>
                        <TextBlock x:Name="SidebarRunStatus" Grid.Row="1" Text="Pronto" FontSize="14" FontWeight="SemiBold" Foreground="#DFC18C" Margin="0,9,0,10"/>
                        <TextBox x:Name="SidebarActivity" Grid.Row="2" Text="Inicie um preset para acompanhar a execução aqui." IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#A5ADA0" FontSize="11" Padding="0"/>
                        <Button Grid.Row="3" Content="Ver execução  →" Click="BtnHome_Click" Margin="0,12,0,0" Padding="9,7" FontSize="11"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="3" Text="MACRO MIR4     /     v1.0.0" Foreground="#6E7569" FontSize="9" Margin="8,0"/>
            </Grid>
        </Border>
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
    </Grid>
</Window>
