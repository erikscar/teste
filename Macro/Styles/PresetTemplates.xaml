<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="PresetSummaryTemplate">
        <StackPanel>
            <WrapPanel Margin="0,0,0,14">
                <Border Background="#332C22" CornerRadius="5" Padding="10,5" Margin="0,0,8,6">
                    <TextBlock Text="{Binding ScheduleLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                </Border>
                <Border Background="#292A2C" CornerRadius="5" Padding="10,5" Margin="0,0,0,6">
                    <TextBlock Text="{Binding StepCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </Border>
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" BorderBrush="#363530" BorderThickness="0,0,0,1" CornerRadius="4" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Background="#393126" CornerRadius="4" Width="28" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Number}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,2,12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#30302C" CornerRadius="5" Padding="9,4" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Repeat}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
