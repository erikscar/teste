<Page x:Class="Macro.Views.FarmingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Macro.Controls" Title="Farming" Background="{StaticResource CanvasBrush}" FontFamily="{StaticResource PoppinsFont}" FontSize="14">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MacroMir4;component/Styles/FarmingTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CarouselArrow" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#D9111214" />
                <Setter Property="BorderBrush" Value="#668F8069" />
            </Style>
            <Style x:Key="DonationChoice" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Margin" Value="0,0,10,8" />
            </Style>
            <Style x:Key="RoutineInfoButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Help" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
                <Setter Property="ToolTipService.ShowDuration" Value="30000" />
                <EventSetter Event="Click" Handler="RoutineInfo_Click" />
            </Style>
            <ItemsPanelTemplate x:Key="CardsPanel">
                <WrapPanel />
            </ItemsPanelTemplate>
            <Style x:Key="FarmingNavigationTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="#C7C4BC" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#373933" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,1" CornerRadius="4" Padding="8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border x:Name="IconSurface" Width="20" Height="24" Background="Transparent" VerticalAlignment="Center">
                                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="17" Height="17"
                                              Stretch="Uniform" Stroke="#DDB775" StrokeThickness="1.6" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" Margin="8,0,0,0" TextWrapping="Wrap"
                                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="#2C2D27" />
                                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="#746347" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="#24271F" />
                                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="#DDB775" />
                                    <Setter TargetName="TabSurface" Property="BorderThickness" Value="0,0,0,2" />
                                    <Setter Property="Foreground" Value="#FFF2D7" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TabSurface" Property="BorderThickness" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabSurface" Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="DailyMissionTemplate">
                <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Raridade do item" Margin="0,12,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableGrades}" SelectedItem="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="Raridade do item da missão" />
                        <TextBlock Text="Mapas (selecione até 10)" Margin="0,14,0,6" />
                        <ListBox Height="150" Background="#222220" Foreground="#F4F4F4" BorderBrush="#55534C" BorderThickness="1"
                                 ItemsSource="{Binding DataContext.DailyMissionMaps, RelativeSource={RelativeSource AncestorType=Page}}"
                                 SelectionMode="Multiple" SelectionChanged="DailyMissionMaps_SelectionChanged" Loaded="DailyMissionMaps_Loaded"
                                 AutomationProperties.Name="Mapas da missão diária">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}"
                                              IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}"
                                              Focusable="False" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="#F4F4F4" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="MapRow" Background="{TemplateBinding Background}" CornerRadius="3"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="MapRow" Property="Background" Value="#343330" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="MapRow" Property="Background" Value="#493E30" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
    <ScrollViewer x:Name="FarmingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24">
            <Grid>
                <StackPanel>
                    <TextBlock Text="OPERAÇÕES / ROTINAS" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="Farming" Style="{StaticResource Heading}" />
                    <TextBlock Text="Configure as opções e inicie o macro." Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,0,0">
                    <TextBlock Text="MIR4" FontWeight="SemiBold" Margin="0,0,22,0" />
                    <Ellipse Width="8" Height="8" Fill="#2CC780" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Pronto" />
                </StackPanel>
            </Grid>
            <Expander x:Name="ConfigurationExpander" Header="Configurações e abas — clique para recolher ou expandir"
                      IsExpanded="True" Margin="0,12,0,0" Foreground="#F4F4F4">
            <StackPanel x:Name="ConfigurationPanel">
                <Border Style="{StaticResource Card}" Margin="0,8,0,20" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Configurar preset" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Configure as abas e salve o fluxo. Use Início para executar e Presets para gerenciar os fluxos salvos." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <StackPanel Width="240" Margin="0,0,12,12">
                                <TextBlock Text="Fluxos salvos" Margin="0,0,0,7" />
                                <ComboBox x:Name="PresetSelector" DisplayMemberPath="Name" SelectionChanged="Preset_SelectionChanged" AutomationProperties.Name="Presets salvos" />
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,12,12">
                                <TextBlock Text="Nome do preset" Margin="0,0,0,7" />
                                <TextBox x:Name="PresetName" MaxLength="80" AutomationProperties.Name="Nome do preset" />
                            </StackPanel>
                            <Button Content="Salvar preset" Click="SavePreset_Click" VerticalAlignment="Bottom" Margin="0,0,12,12" />
                            <Button Content="Limpar" Click="ClearConfiguration_Click" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                    ToolTip="Limpar as configurações atuais sem excluir os presets salvos"
                                    AutomationProperties.Name="Limpar configurações do Farming" />
                        </WrapPanel>
                        <TextBlock Text="Salvar com o mesmo nome atualiza o preset. Ao selecioná-lo, todas as configurações são carregadas." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="A ordem de execução pode ser alterada na página Presets. Somente rotinas ativadas são executadas." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Horário para iniciar" FontWeight="SemiBold" />
                                <TextBlock Text="Formato 24h (HH:mm). Deixe vazio para iniciar agora." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="90" Text="{Binding Configuration.StartTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário para iniciar o macro" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TabControl ItemContainerStyle="{StaticResource FarmingNavigationTab}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <StackPanel>
                                <UniformGrid Columns="4" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" Margin="-4,0,-4,12" />
                                <Border Background="Transparent" Padding="0,10,0,0">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                </Border>
                            </StackPanel>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="Rotinas diárias" Tag="M4,4 L20,4 L20,21 L4,21 Z M8,1 L8,7 M16,1 L16,7 M4,10 L20,10 M8,15 L11,18 L17,12">
                <Border Style="{StaticResource Card}" Margin="0,8,0,20" CornerRadius="4" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="4" Background="#332C22" Margin="0,0,12,0">
                                    <TextBlock Text="✦" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="Doação diária" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Content="i" Style="{StaticResource RoutineInfoButton}" Margin="9,0,0,0"
                                            AutomationProperties.Name="Informações da rotina"><Button.ToolTip><ToolTip Background="#242820" Foreground="#F5F0E5" BorderBrush="#8A7550" Padding="12" Placement="Bottom"><TextBlock Text="Prepara o personagem com a doação diária antes das raids. Selecione os launchers em que a rotina deve ser executada." MaxWidth="340" TextWrapping="Wrap" FontFamily="{StaticResource PoppinsFont}" FontSize="12" Foreground="#F5F0E5" /></ToolTip></Button.ToolTip></Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Launchers da doação diária" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <WrapPanel>
                            <CheckBox x:Name="DonateLauncher1" Style="{StaticResource DonationChoice}" Content="Launcher 1" Tag="MIR4 Launcher 1" Checked="DonationLauncher_Checked" Unchecked="DonationLauncher_Unchecked" />
                            <CheckBox x:Name="DonateLauncher2" Style="{StaticResource DonationChoice}" Content="Launcher 2" Tag="MIR4 Launcher 2" Checked="DonationLauncher_Checked" Unchecked="DonationLauncher_Unchecked" />
                            <CheckBox x:Name="DonateSteam" Style="{StaticResource DonationChoice}" Content="Steam" Tag="MIR4 Steam" Checked="DonationLauncher_Checked" Unchecked="DonationLauncher_Unchecked" />
                        </WrapPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pergaminho Diário" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="i" Style="{StaticResource RoutineInfoButton}" Margin="9,0,0,0"
                                        AutomationProperties.Name="Informações da rotina"><Button.ToolTip><ToolTip Background="#242820" Foreground="#F5F0E5" BorderBrush="#8A7550" Padding="12" Placement="Bottom"><TextBlock Text="Pressiona F10 e compra o pergaminho diário. Selecione um ou mais launchers para executar esta rotina." MaxWidth="340" TextWrapping="Wrap" FontFamily="{StaticResource PoppinsFont}" FontSize="12" Foreground="#F5F0E5" /></ToolTip></Button.ToolTip></Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Configure a compra e a limpeza para cada launcher." Style="{StaticResource Caption}" Margin="0,8,0,14" />
                        <WrapPanel>
                            <Border Width="220" Padding="16" Margin="0,0,12,12" CornerRadius="10" Background="#22251E" BorderBrush="#454A3B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Launcher 1" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                                    <CheckBox x:Name="ScrollLauncher1" Content="Comprar pergaminho" Tag="MIR4 Launcher 1" Checked="ScrollLauncher_Checked" Unchecked="ScrollLauncher_Unchecked" AutomationProperties.Name="Comprar pergaminho — Launcher 1" />
                                    <Border Height="1" Background="#3C4134" Margin="0,14" />
                                    <CheckBox Content="Limpar mochila" IsChecked="{Binding Configuration.DailyScrollCleanBackpackLauncher1, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChecked, ElementName=ScrollLauncher1}" AutomationProperties.Name="Limpar mochila — Launcher 1">
                                        <CheckBox.ToolTip>
                                            <ToolTip Background="#242820" Foreground="#F5F0E5" BorderBrush="#8A7550" Padding="12" Placement="Bottom">
                                                <TextBlock Text="Limpa a mochila antes de comprar o pergaminho. Configure a Seleção autom. do jogo para equipamentos verdes e materiais cinzas." MaxWidth="300" TextWrapping="Wrap" />
                                            </ToolTip>
                                        </CheckBox.ToolTip>
                                    </CheckBox>
                                    <TextBlock Text="Equipamentos verdes&#10;e materiais cinzas" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="24,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Width="220" Padding="16" Margin="0,0,12,12" CornerRadius="10" Background="#22251E" BorderBrush="#454A3B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Launcher 2" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                                    <CheckBox x:Name="ScrollLauncher2" Content="Comprar pergaminho" Tag="MIR4 Launcher 2" Checked="ScrollLauncher_Checked" Unchecked="ScrollLauncher_Unchecked" AutomationProperties.Name="Comprar pergaminho — Launcher 2" />
                                    <Border Height="1" Background="#3C4134" Margin="0,14" />
                                    <CheckBox Content="Limpar mochila" IsChecked="{Binding Configuration.DailyScrollCleanBackpackLauncher2, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChecked, ElementName=ScrollLauncher2}" AutomationProperties.Name="Limpar mochila — Launcher 2">
                                        <CheckBox.ToolTip>
                                            <ToolTip Background="#242820" Foreground="#F5F0E5" BorderBrush="#8A7550" Padding="12" Placement="Bottom">
                                                <TextBlock Text="Limpa a mochila antes de comprar o pergaminho. Configure a Seleção autom. do jogo para equipamentos verdes e materiais cinzas." MaxWidth="300" TextWrapping="Wrap" />
                                            </ToolTip>
                                        </CheckBox.ToolTip>
                                    </CheckBox>
                                    <TextBlock Text="Equipamentos verdes&#10;e materiais cinzas" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="24,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Width="220" Padding="16" Margin="0,0,12,12" CornerRadius="10" Background="#22251E" BorderBrush="#454A3B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Steam" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                                    <CheckBox x:Name="ScrollSteam" Content="Comprar pergaminho" Tag="MIR4 Steam" Checked="ScrollLauncher_Checked" Unchecked="ScrollLauncher_Unchecked" AutomationProperties.Name="Comprar pergaminho — Steam" />
                                    <Border Height="1" Background="#3C4134" Margin="0,14" />
                                    <CheckBox Content="Limpar mochila" IsChecked="{Binding Configuration.DailyScrollCleanBackpackSteam, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChecked, ElementName=ScrollSteam}" AutomationProperties.Name="Limpar mochila — Steam">
                                        <CheckBox.ToolTip>
                                            <ToolTip Background="#242820" Foreground="#F5F0E5" BorderBrush="#8A7550" Padding="12" Placement="Bottom">
                                                <TextBlock Text="Limpa a mochila antes de comprar o pergaminho. Configure a Seleção autom. do jogo para equipamentos verdes e materiais cinzas." MaxWidth="300" TextWrapping="Wrap" />
                                            </ToolTip>
                                        </CheckBox.ToolTip>
                                    </CheckBox>
                                    <TextBlock Text="Equipamentos verdes&#10;e materiais cinzas" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="24,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Completar as 10/10 diárias" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="i" Style="{StaticResource RoutineInfoButton}" Margin="9,0,0,0"
                                        AutomationProperties.Name="Informações da rotina"><Button.ToolTip><ToolTip Background="#242820" Foreground="#F5F0E5" BorderBrush="#8A7550" Padding="12" Placement="Bottom"><TextBlock Text="Cria material raro, encanta e executa os deslocamentos e atalhos de energia, ervas e minério. A conclusão das 10 missões ainda não é verificada automaticamente. Selecione um ou mais launchers para ativar." MaxWidth="340" TextWrapping="Wrap" FontFamily="{StaticResource PoppinsFont}" FontSize="12" Foreground="#F5F0E5" /></ToolTip></Button.ToolTip></Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Launchers da rotina 10/10" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <WrapPanel>
                            <CheckBox x:Name="TenOfTenLauncher1" Style="{StaticResource DonationChoice}" Content="Launcher 1" Tag="MIR4 Launcher 1" Checked="TenOfTenLauncher_Checked" Unchecked="TenOfTenLauncher_Unchecked" />
                            <CheckBox x:Name="TenOfTenLauncher2" Style="{StaticResource DonationChoice}" Content="Launcher 2" Tag="MIR4 Launcher 2" Checked="TenOfTenLauncher_Checked" Unchecked="TenOfTenLauncher_Unchecked" />
                            <CheckBox x:Name="TenOfTenSteam" Style="{StaticResource DonationChoice}" Content="Steam" Tag="MIR4 Steam" Checked="TenOfTenLauncher_Checked" Unchecked="TenOfTenLauncher_Unchecked" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                    </TabItem>
                    <TabItem Header="Raids Normais" Tag="M3,2 L8,3 L19,18 M16,14 L21,19 M2,20 L7,15 M3,21 L20,4 L21,2 L18,3 M3,15 L9,21">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Raids Normais" Style="{StaticResource PageSectionHeading}" /><Button Content="i" Style="{StaticResource RoutineInfoButton}" Margin="9,0,0,0" AutomationProperties.Name="Informações da rotina"><Button.ToolTip><ToolTip Background="#242820" Foreground="#F5F0E5" BorderBrush="#8A7550" Padding="12" Placement="Bottom"><TextBlock Text="Selecione os launchers, ative a raide e informe a quantidade de execuções. Executada no starter e nos convidados selecionados, na ordem definida no preset." MaxWidth="340" TextWrapping="Wrap" FontFamily="{StaticResource PoppinsFont}" FontSize="12" Foreground="#F5F0E5" /></ToolTip></Button.ToolTip></Button></StackPanel>
<WrapPanel Margin="0,12,0,0"><StackPanel Width="240" Margin="0,0,12,12"><TextBlock Text="Starter" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Launchers}" SelectedItem="{Binding Configuration.NormalLaunchers.Starter}" AutomationProperties.Name="Starter" /></StackPanel><StackPanel Width="240" Margin="0,0,12,12"><TextBlock Text="Convidado 1" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding GuestLaunchers}" SelectedItem="{Binding Configuration.NormalLaunchers.Guest1}" AutomationProperties.Name="Convidado 1" /></StackPanel><StackPanel Width="240" Margin="0,0,12,12"><TextBlock Text="Convidado 2" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding GuestLaunchers}" SelectedItem="{Binding Configuration.NormalLaunchers.Guest2}" AutomationProperties.Name="Convidado 2" /></StackPanel></WrapPanel>
                            
                            <Border Style="{StaticResource SelectableCard}" DataContext="{Binding Configuration.Normal}" Width="400" HorizontalAlignment="Left">
                                <StackPanel>
                                    <Grid Height="150" Margin="0,0,0,16" ClipToBounds="True" Background="#242322">
                                        <Image x:Name="NormalRaidImage" Source="/MacroMir4;component/Assets/raid-slide-1.png" Stretch="UniformToFill" />
                                        <Button Style="{StaticResource CarouselArrow}" HorizontalAlignment="Left" Margin="8,0,0,0" Click="PreviousNormalRaidImage_Click" ToolTip="Imagem anterior" AutomationProperties.Name="Imagem anterior da raid normal">
                                            <Path Data="M 8,0 L 0,7 L 8,14" Stroke="#F4F4F4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Button Style="{StaticResource CarouselArrow}" HorizontalAlignment="Right" Margin="0,0,8,0" Click="NextNormalRaidImage_Click" ToolTip="Próxima imagem" AutomationProperties.Name="Próxima imagem da raid normal">
                                            <Path Data="M 0,0 L 8,7 L 0,14" Stroke="#F4F4F4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Border Background="#D9111214" CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                            <TextBlock x:Name="NormalRaidImageCounter" Text="1 / 2" FontSize="11" />
                                        </Border>
                                        <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5" Background="#D9111214" ToolTip="Ativar ou desativar raid normal" AutomationProperties.Name="Ativar raid normal" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Quantidade de vezes" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="Quantidade de repetições da raid normal" />
                                    </Grid>
                                    
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Raids Boss" Tag="M2,5 L7,10 L12,3 L17,10 L22,5 L19,19 L5,19 Z M5,22 L19,22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Raids Boss" Style="{StaticResource PageSectionHeading}" /><Button Content="i" Style="{StaticResource RoutineInfoButton}" Margin="9,0,0,0" AutomationProperties.Name="Informações da rotina"><Button.ToolTip><ToolTip Background="#242820" Foreground="#F5F0E5" BorderBrush="#8A7550" Padding="12" Placement="Bottom"><TextBlock Text="Selecione os launchers, ative a raide boss e informe a quantidade de execuções. Executada no starter e nos convidados selecionados, na ordem definida no preset." MaxWidth="340" TextWrapping="Wrap" FontFamily="{StaticResource PoppinsFont}" FontSize="12" Foreground="#F5F0E5" /></ToolTip></Button.ToolTip></Button></StackPanel>
