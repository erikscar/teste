<Page x:Class="Macro.Views.FarmingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Macro.Controls" Title="Farming" Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MacroMir4;component/Styles/FarmingTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CarouselArrow" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#D9111214" />
                <Setter Property="BorderBrush" Value="#668F8069" />
            </Style>
            <Style x:Key="DonationChoice" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Background" Value="#242422" />
                <Setter Property="Margin" Value="0,0,10,8" />
            </Style>
            <ItemsPanelTemplate x:Key="CardsPanel">
                <WrapPanel />
            </ItemsPanelTemplate>
            <DataTemplate x:Key="DailyMissionTemplate">
                <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Raridade do item" Margin="0,12,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableGrades}" SelectedItem="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="Raridade do item da missão" />
                        <TextBlock Text="Mapas (selecione até 10)" Margin="0,14,0,6" />
                        <ListBox Height="150" Background="#222220" Foreground="#F4F4F4" BorderBrush="#55534C" BorderThickness="1"
                                 ItemsSource="{Binding DataContext.DailyMissionMaps, RelativeSource={RelativeSource AncestorType=Page}}"
                                 SelectionMode="Multiple" SelectionChanged="DailyMissionMaps_SelectionChanged" Loaded="DailyMissionMaps_Loaded"
                                 AutomationProperties.Name="Mapas da missão diária">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}"
                                              IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}"
                                              Focusable="False" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="#F4F4F4" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="MapRow" Background="{TemplateBinding Background}" CornerRadius="3"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="MapRow" Property="Background" Value="#343330" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="MapRow" Property="Background" Value="#493E30" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
    <ScrollViewer x:Name="FarmingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Farming" Style="{StaticResource Heading}" />
                    <TextBlock Text="Configure as opções e inicie o macro." Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,0,0">
                    <TextBlock Text="MIR4" FontWeight="SemiBold" Margin="0,0,22,0" />
                    <Ellipse Width="8" Height="8" Fill="#2CC780" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Pronto" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="ConfigurationPanel">
                <Border Style="{StaticResource Card}" Margin="0,8,0,20" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Configurar preset" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Configure as abas e salve o fluxo. Use Início para executar e Presets para gerenciar os fluxos salvos." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <StackPanel Width="240" Margin="0,0,12,12">
                                <TextBlock Text="Fluxos salvos" Margin="0,0,0,7" />
                                <ComboBox x:Name="PresetSelector" DisplayMemberPath="Name" SelectionChanged="Preset_SelectionChanged" AutomationProperties.Name="Presets salvos" />
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,12,12">
                                <TextBlock Text="Nome do preset" Margin="0,0,0,7" />
                                <TextBox x:Name="PresetName" MaxLength="80" AutomationProperties.Name="Nome do preset" />
                            </StackPanel>
                            <Button Content="Salvar preset" Click="SavePreset_Click" VerticalAlignment="Bottom" Margin="0,0,12,12" />
                        </WrapPanel>
                        <TextBlock Text="Salvar com o mesmo nome atualiza o preset. Ao selecioná-lo, todas as configurações são carregadas." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="A ordem de execução pode ser alterada na página Presets. Somente rotinas ativadas são executadas." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Horário para iniciar" FontWeight="SemiBold" />
                                <TextBlock Text="Formato 24h (HH:mm). Deixe vazio para iniciar agora." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="90" Text="{Binding Configuration.StartTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário para iniciar o macro" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TabControl>
                    <TabItem Header="Rotinas diárias">
                <Border Style="{StaticResource Card}" Margin="0,8,0,20" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="12" Background="#332C22" Margin="0,0,12,0">
                                    <TextBlock Text="✦" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Doação diária" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Preparação antes das raids" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Configuration.DailyDonation}" Checked="DailyDonation_Toggled" Unchecked="DailyDonation_Toggled" VerticalAlignment="Center" ToolTip="Ativar doação diária" AutomationProperties.Name="Ativar doação diária" />
                        </Grid>
                        <TextBlock Text="Launchers da doação diária" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <WrapPanel>
                            <CheckBox x:Name="DonateLauncher1" Style="{StaticResource DonationChoice}" Content="Launcher 1" Tag="MIR4 Launcher 1" Checked="DonationLauncher_Checked" Unchecked="DonationLauncher_Unchecked" />
                            <CheckBox x:Name="DonateLauncher2" Style="{StaticResource DonationChoice}" Content="Launcher 2" Tag="MIR4 Launcher 2" Checked="DonationLauncher_Checked" Unchecked="DonationLauncher_Unchecked" />
                            <CheckBox x:Name="DonateSteam" Style="{StaticResource DonationChoice}" Content="Steam" Tag="MIR4 Steam" Checked="DonationLauncher_Checked" Unchecked="DonationLauncher_Unchecked" />
                        </WrapPanel>
                        <TextBlock Text="Você pode selecionar os três launchers para a doação." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DailyScroll" FontWeight="SemiBold" />
                                <TextBlock Text="Compra o pergaminho diário após pressionar F10" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Configuration.DailyScroll}" Checked="DailyScroll_Toggled" Unchecked="DailyScroll_Toggled" VerticalAlignment="Center" ToolTip="Ativar rotina DailyScroll" AutomationProperties.Name="Ativar rotina DailyScroll" />
                        </Grid>
                        <TextBlock Text="Launchers do DailyScroll" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <WrapPanel>
                            <CheckBox x:Name="ScrollLauncher1" Style="{StaticResource DonationChoice}" Content="Launcher 1" Tag="MIR4 Launcher 1" Checked="ScrollLauncher_Checked" Unchecked="ScrollLauncher_Unchecked" />
                            <CheckBox x:Name="ScrollLauncher2" Style="{StaticResource DonationChoice}" Content="Launcher 2" Tag="MIR4 Launcher 2" Checked="ScrollLauncher_Checked" Unchecked="ScrollLauncher_Unchecked" />
                            <CheckBox x:Name="ScrollSteam" Style="{StaticResource DonationChoice}" Content="Steam" Tag="MIR4 Steam" Checked="ScrollLauncher_Checked" Unchecked="ScrollLauncher_Unchecked" />
                        </WrapPanel>
                        <TextBlock Text="Você pode selecionar os três launchers para o DailyScroll." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Completar as 10/10 diárias" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox x:Name="TenOfTenToggle" Grid.Column="1" Style="{StaticResource Toggle}"
                                      IsChecked="{Binding Configuration.DailyTenOfTenEnabled}"
                                      ToolTip="Ativar completar as 10/10 diárias" AutomationProperties.Name="Ativar completar as 10/10 diárias" />
                        </Grid>
                        <TextBlock Text="Vai coletar ervas, energia e minério e criar um item para completar as missões diárias." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <TextBlock Text="Launchers da rotina 10/10" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel>
                            <CheckBox x:Name="TenOfTenLauncher1" Style="{StaticResource DonationChoice}" Content="Launcher 1" Tag="MIR4 Launcher 1" Checked="TenOfTenLauncher_Checked" Unchecked="TenOfTenLauncher_Unchecked" />
                            <CheckBox x:Name="TenOfTenLauncher2" Style="{StaticResource DonationChoice}" Content="Launcher 2" Tag="MIR4 Launcher 2" Checked="TenOfTenLauncher_Checked" Unchecked="TenOfTenLauncher_Unchecked" />
                            <CheckBox x:Name="TenOfTenSteam" Style="{StaticResource DonationChoice}" Content="Steam" Tag="MIR4 Steam" Checked="TenOfTenLauncher_Checked" Unchecked="TenOfTenLauncher_Unchecked" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                    </TabItem>
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⚔" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="Raids Normais" /></StackPanel></TabItem.Header>
                        <StackPanel>
                            <TextBlock Text="Raids Normais" Style="{StaticResource PageSectionHeading}" />
<WrapPanel Margin="0,12,0,0"><StackPanel Width="240" Margin="0,0,12,12"><TextBlock Text="Starter" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Launchers}" SelectedItem="{Binding Configuration.NormalLaunchers.Starter}" AutomationProperties.Name="Starter" /></StackPanel><StackPanel Width="240" Margin="0,0,12,12"><TextBlock Text="Convidado 1" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding GuestLaunchers}" SelectedItem="{Binding Configuration.NormalLaunchers.Guest1}" AutomationProperties.Name="Convidado 1" /></StackPanel><StackPanel Width="240" Margin="0,0,12,12"><TextBlock Text="Convidado 2" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding GuestLaunchers}" SelectedItem="{Binding Configuration.NormalLaunchers.Guest2}" AutomationProperties.Name="Convidado 2" /></StackPanel></WrapPanel>
                            <TextBlock Text="Selecione a raide e a quantidade de vezes. A ordem de execução do macro é mantida." Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource SelectableCard}" DataContext="{Binding Configuration.Normal}" Width="400" HorizontalAlignment="Left">
                                <StackPanel>
                                    <Grid Height="150" Margin="0,0,0,16" ClipToBounds="True" Background="#242322">
                                        <Image x:Name="NormalRaidImage" Source="/MacroMir4;component/Assets/raid-slide-1.png" Stretch="UniformToFill" />
                                        <Button Style="{StaticResource CarouselArrow}" HorizontalAlignment="Left" Margin="8,0,0,0" Click="PreviousNormalRaidImage_Click" ToolTip="Imagem anterior" AutomationProperties.Name="Imagem anterior da raid normal">
                                            <Path Data="M 8,0 L 0,7 L 8,14" Stroke="#F4F4F4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Button Style="{StaticResource CarouselArrow}" HorizontalAlignment="Right" Margin="0,0,8,0" Click="NextNormalRaidImage_Click" ToolTip="Próxima imagem" AutomationProperties.Name="Próxima imagem da raid normal">
                                            <Path Data="M 0,0 L 8,7 L 0,14" Stroke="#F4F4F4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Border Background="#D9111214" CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                            <TextBlock x:Name="NormalRaidImageCounter" Text="1 / 2" FontSize="11" />
                                        </Border>
                                        <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5" Background="#D9111214" ToolTip="Ativar ou desativar raid normal" AutomationProperties.Name="Ativar raid normal" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Quantidade de vezes" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="Quantidade de repetições da raid normal" />
                                    </Grid>
                                    <TextBlock Text="Executada no starter e nos convidados selecionados." Style="{StaticResource Caption}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="♛" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="Raids Boss" /></StackPanel></TabItem.Header>
                        <StackPanel>
                            <TextBlock Text="Raids Boss" Style="{StaticResource PageSectionHeading}" />
<WrapPanel Margin="0,12,0,0"><StackPanel Width="240" Margin="0,0,12,12"><TextBlock Text="Starter" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Launchers}" SelectedItem="{Binding Configuration.BossLaunchers.Starter}" AutomationProperties.Name="Starter" /></StackPanel><StackPanel Width="240" Margin="0,0,12,12"><TextBlock Text="Convidado 1" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding GuestLaunchers}" SelectedItem="{Binding Configuration.BossLaunchers.Guest1}" AutomationProperties.Name="Convidado 1" /></StackPanel><StackPanel Width="240" Margin="0,0,12,12"><TextBlock Text="Convidado 2" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding GuestLaunchers}" SelectedItem="{Binding Configuration.BossLaunchers.Guest2}" AutomationProperties.Name="Convidado 2" /></StackPanel></WrapPanel>
                            <TextBlock Text="Executadas depois das raids normais, com os launchers escolhidos nesta aba." Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource SelectableCard}" DataContext="{Binding Configuration.Boss}" Width="400" HorizontalAlignment="Left">
                                <StackPanel>
                                    <Grid Height="150" Margin="0,0,0,16" ClipToBounds="True" Background="#242322">
                                        <Image x:Name="BossRaidImage" Source="/MacroMir4;component/Assets/boss-slide-1.png" Stretch="UniformToFill" />
                                        <Button Style="{StaticResource CarouselArrow}" HorizontalAlignment="Left" Margin="8,0,0,0" Click="PreviousBossRaidImage_Click" ToolTip="Imagem anterior" AutomationProperties.Name="Imagem anterior da raid boss">
                                            <Path Data="M 8,0 L 0,7 L 8,14" Stroke="#F4F4F4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Button Style="{StaticResource CarouselArrow}" HorizontalAlignment="Right" Margin="0,0,8,0" Click="NextBossRaidImage_Click" ToolTip="Próxima imagem" AutomationProperties.Name="Próxima imagem da raid boss">
                                            <Path Data="M 0,0 L 8,7 L 0,14" Stroke="#F4F4F4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Border Background="#D9111214" CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                            <TextBlock x:Name="BossRaidImageCounter" Text="1 / 2" FontSize="11" />
                                        </Border>
                                        <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5" Background="#D9111214" ToolTip="Ativar ou desativar raid boss" AutomationProperties.Name="Ativar raid boss" />
                                    </Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Quantidade de vezes" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="Quantidade de repetições da raid boss" />
                                    </Grid>
                                    <TextBlock Text="Executada no starter e nos convidados selecionados." Style="{StaticResource Caption}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="Missões Diárias" /></StackPanel></TabItem.Header>
                        <StackPanel>
                            <TextBlock Text="Missões Diárias" Style="{StaticResource PageSectionHeading}" />
                            <TextBlock Text="O macro atual executa as missões favoritas selecionadas dentro do jogo." Style="{StaticResource Caption}" />
                            <TextBlock Text="Escolha os launchers e marque em quais executar as missões favoritas." Style="{StaticResource Caption}" />
                            <TextBlock Text="Launchers das missões diárias" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,12">
                                <StackPanel Width="205" Margin="0,0,12,10">
                                    <CheckBox x:Name="DailyLauncher1" Style="{StaticResource DonationChoice}" Content="Launcher 1" Tag="MIR4 Launcher 1" Checked="DailyLauncher_Checked" Unchecked="DailyLauncher_Unchecked" />
                                    <CheckBox x:Name="DailyFavoriteLauncher1" Content="Executar as missões favoritas" Tag="MIR4 Launcher 1" Checked="DailyFavoriteLauncher_Checked" Unchecked="DailyFavoriteLauncher_Unchecked" Margin="0,0,0,8" />
                                    <TextBlock Text="Mapa das missões" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                    <ComboBox x:Name="DailyMapLauncher1" Tag="MIR4 Launcher 1" ItemsSource="{Binding MissionMaps}" SelectedItem="Campo" SelectionChanged="DailyMap_SelectionChanged" AutomationProperties.Name="Mapa das missões do Launcher 1" />
                                    <CheckBox x:Name="DailyRetryLauncher1" Content="Retentar se aparecer concluído" Tag="MIR4 Launcher 1" Checked="DailyFavoriteRetry_Checked" Unchecked="DailyFavoriteRetry_Unchecked" Margin="0,10,0,5" />
                                    <TextBlock Text="Mapa da retentativa" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                    <ComboBox x:Name="DailyRetryMapLauncher1" Tag="MIR4 Launcher 1" ItemsSource="{Binding MissionMaps}" SelectedItem="Campo" SelectionChanged="DailyFavoriteRetryMap_SelectionChanged" IsEnabled="{Binding IsChecked, ElementName=DailyRetryLauncher1}" AutomationProperties.Name="Mapa da retentativa do Launcher 1" />
                                </StackPanel>
                                <StackPanel Width="205" Margin="0,0,12,10">
                                    <CheckBox x:Name="DailyLauncher2" Style="{StaticResource DonationChoice}" Content="Launcher 2" Tag="MIR4 Launcher 2" Checked="DailyLauncher_Checked" Unchecked="DailyLauncher_Unchecked" />
                                    <CheckBox x:Name="DailyFavoriteLauncher2" Content="Executar as missões favoritas" Tag="MIR4 Launcher 2" Checked="DailyFavoriteLauncher_Checked" Unchecked="DailyFavoriteLauncher_Unchecked" Margin="0,0,0,8" />
                                    <TextBlock Text="Mapa das missões" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                    <ComboBox x:Name="DailyMapLauncher2" Tag="MIR4 Launcher 2" ItemsSource="{Binding MissionMaps}" SelectedItem="Campo" SelectionChanged="DailyMap_SelectionChanged" AutomationProperties.Name="Mapa das missões do Launcher 2" />
                                    <CheckBox x:Name="DailyRetryLauncher2" Content="Retentar se aparecer concluído" Tag="MIR4 Launcher 2" Checked="DailyFavoriteRetry_Checked" Unchecked="DailyFavoriteRetry_Unchecked" Margin="0,10,0,5" />
                                    <TextBlock Text="Mapa da retentativa" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                    <ComboBox x:Name="DailyRetryMapLauncher2" Tag="MIR4 Launcher 2" ItemsSource="{Binding MissionMaps}" SelectedItem="Campo" SelectionChanged="DailyFavoriteRetryMap_SelectionChanged" IsEnabled="{Binding IsChecked, ElementName=DailyRetryLauncher2}" AutomationProperties.Name="Mapa da retentativa do Launcher 2" />
                                </StackPanel>
                                <StackPanel Width="205" Margin="0,0,12,10">
                                    <CheckBox x:Name="DailySteam" Style="{StaticResource DonationChoice}" Content="Steam" Tag="MIR4 Steam" Checked="DailyLauncher_Checked" Unchecked="DailyLauncher_Unchecked" />
                                    <CheckBox x:Name="DailyFavoriteSteam" Content="Executar as missões favoritas" Tag="MIR4 Steam" Checked="DailyFavoriteLauncher_Checked" Unchecked="DailyFavoriteLauncher_Unchecked" Margin="0,0,0,8" />
                                    <TextBlock Text="Mapa das missões" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                    <ComboBox x:Name="DailyMapSteam" Tag="MIR4 Steam" ItemsSource="{Binding MissionMaps}" SelectedItem="Campo" SelectionChanged="DailyMap_SelectionChanged" AutomationProperties.Name="Mapa das missões do Steam" />
                                    <CheckBox x:Name="DailyRetrySteam" Content="Retentar se aparecer concluído" Tag="MIR4 Steam" Checked="DailyFavoriteRetry_Checked" Unchecked="DailyFavoriteRetry_Unchecked" Margin="0,10,0,5" />
                                    <TextBlock Text="Mapa da retentativa" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                    <ComboBox x:Name="DailyRetryMapSteam" Tag="MIR4 Steam" ItemsSource="{Binding MissionMaps}" SelectedItem="Campo" SelectionChanged="DailyFavoriteRetryMap_SelectionChanged" IsEnabled="{Binding IsChecked, ElementName=DailyRetrySteam}" AutomationProperties.Name="Mapa da retentativa do Steam" />
                                </StackPanel>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Configuration.DailyItems}" ItemTemplate="{StaticResource DailyMissionTemplate}" ItemsPanel="{StaticResource CardsPanel}" />
                            <CheckBox Content="Limpar mochila com equipamentos incomuns" IsEnabled="False" Margin="0,8,0,0" />
                            <TextBlock Text="Limpeza de mochila ainda não implementada." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </TabItem>
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="Missões da Dominação" /></StackPanel></TabItem.Header>
                        <StackPanel>
                            <TextBlock Text="Missões da Dominação" Style="{StaticResource PageSectionHeading}" />
                            <TextBlock Text="A rotina de Dominação ainda não está habilitada no fluxo atual. As configurações são independentes das missões diárias." Style="{StaticResource Caption}" />
                            <ItemsControl ItemsSource="{Binding Configuration.DominationItems}" ItemTemplate="{StaticResource MissionTemplate}" ItemsPanel="{StaticResource CardsPanel}" />
                            <CheckBox Content="Limpar mochila com equipamentos incomuns" IsEnabled="False" Margin="0,8,0,0" />
                            <TextBlock Text="Seleção de mapas e limpeza de mochila aguardam integração." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚔" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Arena" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel>
                            <TextBlock Text="Arena" Style="{StaticResource PageSectionHeading}" />
                            <TextBlock Text="Escolha os launchers e a quantidade de execuções e pressione Executar Arena." Style="{StaticResource Caption}" /><CheckBox Content="Incluir Arena no preset" IsChecked="{Binding Configuration.ArenaEnabled}" Margin="0,8,0,12" />
                            <WrapPanel>
                                <StackPanel Width="240" Margin="0,0,12,12">
                                    <TextBlock Text="Starter da arena" Margin="0,0,0,7" />
                                    <ComboBox ItemsSource="{Binding Launchers}" SelectedItem="{Binding Configuration.ArenaStarter}" AutomationProperties.Name="Starter da arena" />
                                </StackPanel>
                                <StackPanel Width="240" Margin="0,0,12,12">
                                    <TextBlock Text="Convidado da arena" Margin="0,0,0,7" />
                                    <ComboBox ItemsSource="{Binding Launchers}" SelectedItem="{Binding Configuration.ArenaInviter}" AutomationProperties.Name="Convidado da arena" />
                                </StackPanel>
                            </WrapPanel>
                            <Grid Margin="0,0,0,8" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Quantidade de vezes" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Configuration.ArenaRepeatCountText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" ToolTip="Informe de 1 a 100 execuções"
                                         AutomationProperties.Name="Quantidade de repetições da Arena" />
                            </Grid>
                            <Grid Margin="0,0,0,12" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Horário da Arena" VerticalAlignment="Center" /><TextBlock Text="HH:mm; vazio = sem espera" FontSize="11" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding Configuration.ArenaStartTime, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" ToolTip="Horário no formato 24h, por exemplo 21:30"
                                         AutomationProperties.Name="Horário para executar a Arena" />
                            </Grid>
                            <Button x:Name="BtnDoArena" Content="⚔   Executar Arena" Style="{StaticResource PrimaryButton}"
                                    Click="BtnDoArena_Click" HorizontalAlignment="Left" Margin="0,4,0,12" Padding="18,11" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
            <Button Content="Testar captura de janela" Click="PreviewWindow_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,10" />
            <UniformGrid Columns="4" Margin="0,18,0,14">
                <Button x:Name="BtnStart" Content="▶   Iniciar" Style="{StaticResource PrimaryButton}" Click="BtnStart_Click" Margin="0,0,10,0" />
                <Button x:Name="BtnStop" Content="■   Stop" Click="BtnStop_Click" Margin="0,0,10,0" />
                <Button x:Name="BtnMousePercent" Content="MousePercent" Click="BtnMousePercent_Click" Margin="0,0,10,0" />
            </UniformGrid>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Log de execução" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBox x:Name="ExecutionLog" IsReadOnly="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
                </StackPanel>
            </Border>
            <Expander x:Name="CaptureExpander" Header="Captura e detecção da doação" Foreground="#A8A8A8" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Image x:Name="ScreenshotImage" Stretch="Uniform" MaxHeight="450" />
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
        <controls:ActionNotification x:Name="SaveNotification" Panel.ZIndex="20" />
    </Grid>
</Page>
