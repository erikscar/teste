<Page x:Class="Macro.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource CanvasBrush}" FontFamily="{StaticResource PoppinsFont}" FontSize="14" Title="Início">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Text="OPERAÇÕES / VISÃO GERAL" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
            <TextBlock Text="Início" Style="{StaticResource Heading}" />
            <TextBlock Text="Escolha um preset para executar o macro com as configurações salvas." Style="{StaticResource Caption}" />
            <Border Style="{StaticResource Card}" Margin="0,16,0,20">
                <StackPanel>
                    <TextBlock Text="Preset" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ComboBox x:Name="PresetSelector" DisplayMemberPath="Name" SelectionChanged="Preset_SelectionChanged" AutomationProperties.Name="Preset para executar" />
                    <ContentControl x:Name="PresetDetails" ContentTemplate="{StaticResource PresetSummaryTemplate}" HorizontalContentAlignment="Stretch" Margin="0,18,0,0" />
                    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" />
                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="StartButton" Content="▶   Iniciar" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0,0,12,0" />
                        <Button x:Name="StopButton" Content="■   Parar" Click="Stop_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Status" Text="Pronto" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Log de execução" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBox x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" Height="260" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource PoppinsFont}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
