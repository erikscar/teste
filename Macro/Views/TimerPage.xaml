<Page x:Class="Macro.Views.TimerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Macro.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="TimerPage" FontFamily="{StaticResource PoppinsFont}">

    <Grid Background="#111214">

        <Grid.RowDefinitions>

            <!-- Cabeçalho + cards -->
            <RowDefinition Height="Auto"/>

            <!-- Tabela -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- CABEÇALHO + BOSSES DISPONÍVEIS -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0"
                    Margin="28,24,28,12">


            <!-- TÍTULO -->

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,15">

                <Viewbox Width="18"
                         Height="18"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center">

                    <Canvas Width="24"
                            Height="24">

                        <Path Data="M12 4c4.418 0 8 3.358 8 7.5c0 1.901 -.755 3.637 -2 4.96l0 2.54a1 1 0 0 1 -1 1h-10a1 1 0 0 1 -1 -1v-2.54c-1.245 -1.322 -2 -3.058 -2 -4.96c0 -4.142 3.582 -7.5 8 -7.5"
                              Stroke="#f0efec"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"/>

                        <Path Data="M10 17v3"
                              Stroke="#f0efec"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"/>

                        <Path Data="M14 17v3"
                              Stroke="#f0efec"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"/>

                        <Path Data="M8 11a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"
                              Stroke="#f0efec"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"/>

                        <Path Data="M14 11a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"
                              Stroke="#f0efec"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"/>

                    </Canvas>

                </Viewbox>

                <TextBlock Text="Próximos chefes disponíveis"
                           Foreground="#f0efec"
                           FontSize="26"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- CARDS DOS BOSSES DISPONÍVEIS -->
            <!-- ================================================= -->

            <Border x:Name="AvailablePanel"
        Visibility="Collapsed">

                <ItemsControl x:Name="AvailableBossesItemsControl">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>

                            <WrapPanel Orientation="Horizontal"/>

                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Width="200"
                        Height="90"
                        Margin="0,0,10,10"
                        Padding="14"
                        Background="#1C1C1B"
                        BorderBrush="#343330"
                        BorderThickness="1"
                        CornerRadius="5">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>


                                    <!-- NOME DO BOSS -->

                                    <TextBlock Grid.Row="0"
                                   Text="{Binding Name}"
                                   Foreground="#F0EFEC"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>


                                    <!-- MUNDO / LOCALIZAÇÃO -->

                                    <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                        <Border Background="#242322"
                                    CornerRadius="5"
                                    Padding="7,3"
                                    Margin="0,0,7,0">

                                            <TextBlock Text="{Binding World}"
                                           Foreground="#F0EFEC"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>

                                        </Border>

                                        <TextBlock Text="{Binding Localization}"
                                       Foreground="#9B9A94"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>


                                    <!-- STATUS -->

                                    <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">

                                        <Ellipse Width="7"
                                     Height="7"
                                     Fill="#7CCB5E"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>

                                        <TextBlock Text="DISPONÍVEL"
                                       Foreground="#7CCB5E"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Border>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- DATA GRID -->
        <!-- ===================================================== -->

        <DataGrid x:Name="BossDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="#111214"
                  Foreground="#F0EFEC"
                  BorderThickness="0"
                  FontSize="13"
                  RowBackground="#171819"
                  HorizontalScrollBarVisibility="Hidden"
                  AlternatingRowBackground="#111214"
                  Padding="28,0,28,20"
                  RowHeight="48"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">


            <!-- ================================================= -->
            <!-- HEADER DA TABELA -->
            <!-- ================================================= -->

            <DataGrid.ColumnHeaderStyle>

                <Style TargetType="DataGridColumnHeader">

                    <Setter Property="Background"
                            Value="#111214"/>

                    <Setter Property="Foreground"
                            Value="#EBEADC"/>

                    <Setter Property="FontWeight"
                            Value="Bold"/>

                    <Setter Property="BorderThickness"
                            Value="0"/>

                    <Setter Property="Padding"
                            Value="2,0,0,8"/>

                </Style>

            </DataGrid.ColumnHeaderStyle>


            <!-- ================================================= -->
            <!-- RECURSOS -->
            <!-- ================================================= -->

            <DataGrid.Resources>

                <Style x:Key="DataGridTextStyle"
                       TargetType="TextBlock">

                    <Setter Property="VerticalAlignment"
                            Value="Center"/>

                    <Setter Property="HorizontalAlignment"
                            Value="Left"/>

                </Style>
            </DataGrid.Resources>


            <!-- ================================================= -->
            <!-- CÉLULAS -->
            <!-- ================================================= -->

            <DataGrid.CellStyle>

                <Style TargetType="DataGridCell">

                    <Setter Property="Background"
                            Value="#111214"/>

                    <Setter Property="Foreground"
                            Value="#f0efec"/>

                    <Setter Property="BorderThickness"
                            Value="0,1,0,0"/>

                    <Setter Property="BorderBrush"
                            Value="#343330"/>

                    <Setter Property="VerticalContentAlignment"
                            Value="Center"/>

                </Style>

            </DataGrid.CellStyle>


            <!-- ================================================= -->
            <!-- COLUNAS -->
            <!-- ================================================= -->

            <DataGrid.Columns>


                <!-- MUNDO -->

                <DataGridTemplateColumn Header="Mundo"
                                        Width="*">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Border Background="#242322"
                                    CornerRadius="5"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                                <TextBlock Text="{Binding World}"
                                           Style="{StaticResource DataGridTextStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="#f0efec"/>

                            </Border>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!-- LOCALIZAÇÃO -->

                <DataGridTemplateColumn Header="Localização"
                                        Width="2.5*">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding Localization}"
                                       Style="{StaticResource DataGridTextStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="#f0efec"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!-- BOSS -->

                <DataGridTemplateColumn Header="Boss"
                                        Width="2.2*">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Border Background="#38352D"
                                    CornerRadius="5"
                                    Padding="15,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource DataGridTextStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="#D8D0B8"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                            </Border>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!-- TEMPO RESTANTE -->

                <DataGridTemplateColumn Header="Tempo restante"
                                        Width="*">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding TimeRemainingText}"
                                       Style="{StaticResource DataGridTextStyle}"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#E4C18A"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!-- AÇÃO -->

                <DataGridTemplateColumn Header=""
                                        Width=".5*">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Button HorizontalAlignment="Center"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Cursor="Hand"
                                    Padding="4"
                                    Background="Transparent"
                                    BorderThickness="0">

                                <Viewbox Width="18"
                                         Height="18">

                                    <Canvas Width="24"
                                            Height="24">

                                        <Path Data="M15 4.5l-4 4l-4 1.5l-1.5 1.5l7 7l1.5 -1.5l1.5 -4l4 -4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>

                                        <Path Data="M9 15l-4.5 4.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>

                                        <Path Data="M14.5 4l5.5 5.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>

                                    </Canvas>

                                </Viewbox>

                            </Button>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Page>
