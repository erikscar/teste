<Window x:Class="Macro.Views.CommonMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent" FontFamily="{StaticResource PoppinsFont}">

    <Border Background="#202020"
            CornerRadius="10"
            Padding="20">

        <Grid>
            <TextBlock x:Name="TitleText"
                       Grid.Row="1"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock x:Name="MessageText"
                       Grid.Row="2"
                       Margin="0,30,0,15"
                       FontSize="14"
                       Foreground="#DDDDDD"
                       TextWrapping="Wrap"/>

            <Button Cursor="Hand" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" x:Name="BtnIniciar" Click="Ok_Click" FontWeight="SemiBold" Content="OK" Background="#4CAF50" Foreground="White" Margin="20,0,8,0" BorderThickness="0" Width="100" Height="35">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </Border>
</Window>