<Page x:Class="Macro.Views.DailyPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Maps" Background="{StaticResource CanvasBrush}" FontFamily="{StaticResource PoppinsFont}">
    <StackPanel Margin="28,24">
        <TextBlock Text="Maps" Style="{StaticResource Heading}" />
        <TextBlock Text="Selecione o mapa e o item alvo." Style="{StaticResource Caption}" />
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Mapas de missões" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Nenhum mapa de missão cadastrado" FontSize="16" Margin="0,24,0,8" />
                <TextBlock Text="O macro utiliza os favoritos definidos dentro do MIR4. O catálogo de mapas para seleção por item ainda não está disponível." Style="{StaticResource Caption}" MaxWidth="560" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>